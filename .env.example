# ==============================================================================
# Legacy compatibility and non-deployment tooling
# ==============================================================================
# New deployments use one reviewed JSON recipe, not this file:
#   ./symmio recipe init --network arbitrum
#   ./symmio doctor --config deployments/arbitrum.json
#   ./symmio deploy --config deployments/arbitrum.json --plan
#
# Recipe deployments ignore .env. Public deployment intent lives in the JSON file;
# signer, RPC, and explorer credentials are purpose-scoped references, preferably to
# the encrypted Hardhat keystore.
#
# The variables below remain for legacy --network compatibility, upgrade/migration
# scripts, local development, and test tooling. Do not copy this file as the starting
# point for a fresh deployment.
# ==============================================================================

# ------------------------------------------------------------------------------
# Deployer keys
# ------------------------------------------------------------------------------
# NEW_DEPLOYER is the key that signs the deployment. This is the variable
# hardhat.config.ts actually reads — NOT "PRIVATE_KEY".
# Leave empty and set USE_KEYSTORE=true to use the encrypted Hardhat keystore instead
# (./node_modules/.bin/hardhat keystore set NEW_DEPLOYER).
#
# If none of these are set, live HTTP networks configure no signer and writes fail
# closed. The committed dummy key is used only by local development networks.
NEW_DEPLOYER=""
TEAM_DEPLOYER=""

# Additional signers used by the upgrade/migration tooling (scripts/upgrade/*).
# Exposed as hardhat signer indices 1, 2 and 3 respectively.
TEAM_MIGRATOR=""
TEAM_UPGRADE_OPERATOR=""
TEAM_PROPOSER=""

# Legacy mode can read keys and RPC URLs from the encrypted Hardhat keystore instead
# of this file. JSON recipes declare hardhat-keystore:// references directly.
USE_KEYSTORE="false"
KEYSTORE_DEPLOYER_KEY="NEW_DEPLOYER"
# Only these keystore account names are exposed as Hardhat signers. The deployer is
# included automatically; list optional role keys explicitly when a script needs them.
KEYSTORE_ACCOUNTS="NEW_DEPLOYER"

# ------------------------------------------------------------------------------
# RPC endpoints
# ------------------------------------------------------------------------------
# Per-network override, named RPC_<NETWORK> in uppercase. Falls back to a public
# endpoint when unset — set your own for a mainnet deploy, public RPCs rate-limit
# and can silently drop transactions.
RPC_ARBITRUM=""
# RPC_BASE=""
# RPC_BSC=""
# RPC_MANTLE=""
# RPC_HYPEREVM=""

# Optional one-run override used by both Hardhat and the dependency-free CLI.
# This is useful when RPC_<NETWORK> lives only in the encrypted keystore but the
# read-only doctor should inspect contracts through the exact same endpoint.
SYMMIO_RPC_URL_OVERRIDE=""

# Block number to pin fork-* networks to (0 / unset = latest).
FORK_BLOCK_NUMBER=""

# ------------------------------------------------------------------------------
# Block explorer verification
# ------------------------------------------------------------------------------
# Single Etherscan V2 multichain API key. This is the ONLY explorer key the config
# reads — the old per-chain *_API_KEY variables were never wired up and are gone.
ETHERSCAN_APIKEY=""

# ------------------------------------------------------------------------------
# Legacy deployment compatibility (deploy:system without a JSON recipe)
# ------------------------------------------------------------------------------
# Recipe mode ignores every deployment value in this section.
# Admin address receiving all roles and ownership. Local runs may default to the
# deployer; known mainnets require an explicit address distinct from the deployer.
ADMIN_PUBLIC_KEY=""

# Protocol fee receiver. Defaults to ADMIN_PUBLIC_KEY.
SYMMIO_FEE_RECEIVER=""

# REQUIRED ON MAINNET and fork rehearsals. These are economically active
# liquidation settings and must come from the reviewed deployment parameters:
# - excess normal-liquidation LF is credited to LIQUIDATION_INSURANCE_VAULT;
# - the per-position cap uses 18-decimal precision;
# - non-zero soft-liquidation penalties revert if their collector is unset.
# Local/test deployments default both receivers to ADMIN_PUBLIC_KEY and the cap to 100e18.
LIQUIDATION_INSURANCE_VAULT=""
MAX_LIQUIDATION_PROFIT_PER_POSITION=""
SOFT_LIQUIDATION_PENALTY_COLLECTOR=""

# REQUIRED ON MAINNET. The collateral token address.
# If left empty the deploy would create a FakeStablecoin that anyone can mint —
# deploy:system blocks this on known mainnets.
#   Arbitrum One USDC: 0xaf88d065e77c8cC2239327C5EDb3A432268e5831
COLLATERAL_ADDRESS=""

# Number of confirmations to wait for on each setup transaction.
DEPLOY_CONFIRMATIONS="1"

# Receipt wait policy. A slow notice is printed before the run fails, and both
# values are validated before deployment (seconds; notice must be below timeout).
DEPLOY_SLOW_TX_NOTICE="30"
DEPLOY_TX_TIMEOUT="300"

# Deployment log verbosity: silent | minimal | verbose. Verbose is recommended.
# Silent/minimal reduce component chatter; transaction hashes, health/verification
# gates, warnings, and errors remain visible as deployment safety evidence.
DEPLOY_LOG_LEVEL="verbose"

# Resume-only transaction recovery. Leave both empty during a normal run. Use an
# exact original=replacement hash mapping after a same-intent speed-up. Confirm a
# dropped hash only after checking the explorer/RPC and proving its nonce reusable.
DEPLOY_TX_REPLACEMENTS=""
CONFIRM_DROPPED_TX_HASHES=""

# ------------------------------------------------------------------------------
# Optional components
# ------------------------------------------------------------------------------
DEPLOY_PARTYB="true"
# Enable ADL for the deployed SymmioPartyB (only applies when DEPLOY_PARTYB=true).
SET_ADL_ENABLED="false"
# Required when DEPLOY_PARTYB=true (ERC-1271 signature verification).
PARTYB_SIGNER=""

DEPLOY_SYMBOL_MANAGER="true"
# Required when DEPLOY_SYMBOL_MANAGER=true. Receives SYMBOL_ADDER_ROLE and
# SYMBOL_REMOVER_ROLE on the SymbolManager.
SYMBOL_MANAGER_OPERATOR=""

SETUP_INSTANT_LAYER_TEMPLATES="true"

# ------------------------------------------------------------------------------
# Muon signature verifier
# ------------------------------------------------------------------------------
# Use an already-deployed verifier instead of deploying a new one.
MUON_SIGNATURE_VERIFIER_ADDRESS=""

# MUST stay "false" on mainnet. MockMuonSignatureVerifier accepts EVERY signature,
# which makes all price/uPnL/liquidation attestations forgeable.
# deploy:system blocks this on known mainnets.
DEPLOY_MOCK_VERIFIER="false"

MUON_APP_ID=""
MUON_UPNL_VALID_TIME="300"
MUON_PRICE_VALID_TIME="300"
MUON_PUBLIC_KEY_X=""
MUON_PUBLIC_KEY_PARITY=""
# Comma-separated list of gateway signer addresses.
MUON_GATEWAY_SIGNERS=""
# Required for every real verifier deployment. Exact, case-sensitive MuonFunction
# names; general deployments intentionally require all eight categories.
MUON_FUNCTION_PERMISSIONS="Trading,AccountManagement,Settlement,ForceClose,Funding,LiquidationPartyA,LiquidationPartyB,RemoveMargin"

# ==============================================================================
# Local & test-only — must remain false/unset for a mainnet deployment
# ==============================================================================

# Registers a real on-chain "Test Affiliate" on the AccountLayer.
# deploy:system blocks this on known mainnets.
REGISTER_DUMMY_AFFILIATE="false"

# Emergency-only second confirmation for --allow-unsafe-mainnet=true. The value
# must exactly equal the connected mainnet chain id; leave empty for normal runs.
UNSAFE_MAINNET_CONFIRM_CHAIN_ID=""

DEPLOY_MULTICALL="false"

HARDHAT_DOCKER_URL="http://eth-node:8545"

# Test harness configuration
TEST_USER_BALANCE=5000
TEST_USER_MAX_QUOTE=100
HEDGER_WEB_SERVICE="http://127.0.0.1:8090"
TEST_USER_TIMEOUT=120000
LOG_LEVEL=debug
VALIDATION_PROBABILITY=0.2
TEST_MODE=static

# Number of parallel test workers used by ./utils/runTestsInParallel.sh
PARALLEL_JOBS=8

# Multi-actor model-based fuzzing.
# npm run test:fuzz runs continuously; npm run test:fuzz:ci uses the bounded limit.
# Leave FUZZ_SEED unset to generate and print a new replay seed.
FUZZ_RUN_MODE=continuous
FUZZ_USER_COUNT=3
FUZZ_HEDGER_COUNT=2
FUZZ_ROOT_ACTIONS=10
FUZZ_RUN_TIMEOUT_MS=30000
FUZZ_ACTION_TIMEOUT_MS=30000
FUZZ_DRAIN_TIMEOUT_MS=30000
FUZZ_EVENT_POLL_MS=50
# Profile defaults: continuous validates 20%, reports every root, and runs a
# corner campaign every 2 roots; bounded CI validates 100% and campaigns every root.
# Set FUZZ_CORNER_EVERY=0 to disable deliberate corner workflows.
# VALIDATION_PROBABILITY=0.2
# FUZZ_PROGRESS_EVERY=1
# FUZZ_CORNER_EVERY=2
# Provider-event mode only; direct seeded runs queue rethinks in logical order.
FUZZ_RETHINK_DELAY_MS=100
FUZZ_LOG_LEVEL=progress
FUZZ_LOG_FORMAT=pretty
FUZZ_LOG_COLOR=auto
# npm run test:fuzz:dashboard keeps the terminal view and serves live charts
# from loopback while persisting a bounded report under .fuzz-dashboard/.
# FUZZ_DASHBOARD_PORT=4173
# FUZZ_DASHBOARD_FILE=.fuzz-dashboard/report.json
# FUZZ_DASHBOARD_ARCHIVE_DIR=.fuzz-dashboard/runs
# Set only when legacy Winston output is also needed during a fuzz run.
# FUZZ_LEGACY_LOG_LEVEL=debug
# Detailed file logging is opt-in; normal tests no longer grow detailedDebug.log.
# DETAILED_LOG_FILE=detailedDebug.log
