# ==============================================================================
# SYMMIO deployment configuration
# ==============================================================================
# Copy to .env and fill in. Defaults here are SAFE FOR MAINNET — the deploy will
# refuse to run on a known mainnet chain if any unsafe option is enabled.
# For local/testnet work, see "Local & test-only" at the bottom.
# ==============================================================================

# ------------------------------------------------------------------------------
# Deployer keys
# ------------------------------------------------------------------------------
# NEW_DEPLOYER is the key that signs the deployment. This is the variable
# hardhat.config.ts actually reads — NOT "PRIVATE_KEY".
# Leave empty and set USE_KEYSTORE=true to use the encrypted Hardhat keystore instead
# (npx hardhat keystore set NEW_DEPLOYER).
#
# If none of these are set, hardhat.config.ts falls back to a dummy key that is
# committed to this repository. deploy:system will refuse to use it on a mainnet.
NEW_DEPLOYER=""
TEAM_DEPLOYER=""

# Additional signers used by the upgrade/migration tooling (scripts/upgrade/*).
# Exposed as hardhat signer indices 1, 2 and 3 respectively.
TEAM_MIGRATOR=""
TEAM_UPGRADE_OPERATOR=""
TEAM_PROPOSER=""

# Read keys and RPC URLs from the encrypted Hardhat keystore instead of this file.
# Strongly recommended for mainnet deployments.
USE_KEYSTORE="false"
KEYSTORE_DEPLOYER_KEY="NEW_DEPLOYER"

# ------------------------------------------------------------------------------
# RPC endpoints
# ------------------------------------------------------------------------------
# Per-network override, named RPC_<NETWORK> in uppercase. Falls back to a public
# endpoint when unset — set your own for a mainnet deploy, public RPCs rate-limit
# and can silently drop transactions.
RPC_ARBITRUM=""
# RPC_BASE=""
# RPC_BSC=""
# RPC_MANTLE=""
# RPC_HYPEREVM=""

# Block number to pin fork-* networks to (0 / unset = latest).
FORK_BLOCK_NUMBER=""

# ------------------------------------------------------------------------------
# Block explorer verification
# ------------------------------------------------------------------------------
# Single Etherscan V2 multichain API key. This is the ONLY explorer key the config
# reads — the old per-chain *_API_KEY variables were never wired up and are gone.
ETHERSCAN_APIKEY=""

# ------------------------------------------------------------------------------
# Deployment configuration (deploy:system)
# ------------------------------------------------------------------------------
# Admin address receiving all roles and ownership. Defaults to the deployer.
# Set this to your multisig for a mainnet deploy.
ADMIN_PUBLIC_KEY=""

# Protocol fee receiver. Defaults to ADMIN_PUBLIC_KEY.
SYMMIO_FEE_RECEIVER=""

# REQUIRED ON MAINNET. The collateral token address.
# If left empty the deploy would create a FakeStablecoin that anyone can mint —
# deploy:system blocks this on known mainnets.
#   Arbitrum One USDC: 0xaf88d065e77c8cC2239327C5EDb3A432268e5831
COLLATERAL_ADDRESS=""

# Number of confirmations to wait for on each setup transaction.
DEPLOY_CONFIRMATIONS="1"

# Deployment log verbosity: silent | minimal | verbose
DEPLOY_LOG_LEVEL="verbose"

# Optional: Create2Factory for a vanity Diamond address.
# Deploy separately with: npx hardhat deploy:create2factory --network <network>
CREATE2_FACTORY_ADDRESS=""
DIAMOND_VANITY_PREFIX="573310"

# ------------------------------------------------------------------------------
# Optional components
# ------------------------------------------------------------------------------
DEPLOY_PARTYB="true"
# Enable ADL for the deployed SymmioPartyB (only applies when DEPLOY_PARTYB=true).
SET_ADL_ENABLED="false"
# Optional signer address for SymmioPartyB (ERC-1271 signature verification).
PARTYB_SIGNER=""

DEPLOY_SYMBOL_MANAGER="true"
# Address granted SYMBOL_ADDER_ROLE + SYMBOL_REMOVER_ROLE on the SymbolManager.
SYMBOL_MANAGER_OPERATOR=""

SETUP_INSTANT_LAYER_TEMPLATES="true"

# ------------------------------------------------------------------------------
# Muon signature verifier
# ------------------------------------------------------------------------------
# Use an already-deployed verifier instead of deploying a new one.
MUON_SIGNATURE_VERIFIER_ADDRESS=""

# MUST stay "false" on mainnet. MockMuonSignatureVerifier accepts EVERY signature,
# which makes all price/uPnL/liquidation attestations forgeable.
# deploy:system blocks this on known mainnets.
DEPLOY_MOCK_VERIFIER="false"

MUON_APP_ID=""
MUON_UPNL_VALID_TIME="300"
MUON_PRICE_VALID_TIME="300"
MUON_PUBLIC_KEY_X=""
MUON_PUBLIC_KEY_PARITY=""
# Comma-separated list of gateway signer addresses.
MUON_GATEWAY_SIGNERS=""

# ==============================================================================
# Local & test-only — must remain false/unset for a mainnet deployment
# ==============================================================================

# Registers a real on-chain "Test Affiliate" on the AccountLayer.
# deploy:system blocks this on known mainnets.
REGISTER_DUMMY_AFFILIATE="false"

DEPLOY_MULTICALL="false"

HARDHAT_DOCKER_URL="http://eth-node:8545"

# Test harness configuration
TEST_USER_BALANCE=5000
TEST_USER_MAX_QUOTE=100
HEDGER_WEB_SERVICE="http://127.0.0.1:8090"
TEST_USER_TIMEOUT=120000
LOG_LEVEL=debug
VALIDATION_PROBABILITY=0.2
TEST_MODE=static

# Number of parallel test workers used by ./utils/runTestsInParallel.sh
PARALLEL_JOBS=8

# Multi-actor model-based fuzzing.
# npm run test:fuzz runs continuously; npm run test:fuzz:ci uses the bounded limit.
# Leave FUZZ_SEED unset to generate and print a new replay seed.
FUZZ_RUN_MODE=continuous
FUZZ_USER_COUNT=3
FUZZ_HEDGER_COUNT=2
FUZZ_ROOT_ACTIONS=10
FUZZ_RUN_TIMEOUT_MS=30000
FUZZ_ACTION_TIMEOUT_MS=30000
FUZZ_DRAIN_TIMEOUT_MS=30000
FUZZ_EVENT_POLL_MS=50
# Profile defaults: continuous validates 20%, reports every root, and runs a
# corner campaign every 2 roots; bounded CI validates 100% and campaigns every root.
# Set FUZZ_CORNER_EVERY=0 to disable deliberate corner workflows.
# VALIDATION_PROBABILITY=0.2
# FUZZ_PROGRESS_EVERY=1
# FUZZ_CORNER_EVERY=2
# Provider-event mode only; direct seeded runs queue rethinks in logical order.
FUZZ_RETHINK_DELAY_MS=100
FUZZ_LOG_LEVEL=progress
FUZZ_LOG_FORMAT=pretty
FUZZ_LOG_COLOR=auto
# npm run test:fuzz:dashboard keeps the terminal view and serves live charts
# from loopback while persisting a bounded report under .fuzz-dashboard/.
# FUZZ_DASHBOARD_PORT=4173
# FUZZ_DASHBOARD_FILE=.fuzz-dashboard/report.json
# FUZZ_DASHBOARD_ARCHIVE_DIR=.fuzz-dashboard/runs
# Set only when legacy Winston output is also needed during a fuzz run.
# FUZZ_LEGACY_LOG_LEVEL=debug
# Detailed file logging is opt-in; normal tests no longer grow detailedDebug.log.
# DETAILED_LOG_FILE=detailedDebug.log
