{
	"name": "symmio",
	"description": "Symmio platform contracts",
	"version": "0.8.5",
	"type": "module",
	"author": {
		"name": "MoonKnight/Naveedinno",
		"url": "https://github.com/SYMM-IO/symmio-core"
	},
	"devDependencies": {
		"@ethers-ext/signer-ledger": "^6.0.0-beta.1",
		"@nomicfoundation/hardhat-ethers": "^4.0.3",
		"@nomicfoundation/hardhat-ethers-chai-matchers": "^3.0.10",
		"@nomicfoundation/hardhat-ignition": "^3.1.7",
		"@nomicfoundation/hardhat-ignition-ethers": "^3.1.6",
		"@nomicfoundation/hardhat-keystore": "^3.0.13",
		"@nomicfoundation/hardhat-ledger": "3.0.10",
		"@nomicfoundation/hardhat-mocha": "^3.0.21",
		"@nomicfoundation/hardhat-network-helpers": "^3.0.10",
		"@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.2",
		"@nomicfoundation/hardhat-typechain": "^3.1.1",
		"@nomicfoundation/hardhat-verify": "^3.0.8",
		"@openzeppelin/contracts": "^4.9.6",
		"@openzeppelin/contracts-upgradeable": "^4.9.6",
		"@trivago/prettier-plugin-sort-imports": "^6.0.0",
		"@typechain/ethers-v6": "^0.5.1",
		"@types/chai": "^5.2.3",
		"@types/fs-extra": "^11.0.4",
		"@types/mocha": "^10.0.7",
		"@types/node": "^22.19.0",
		"builder-pattern": "^2.2.0",
		"chai": "^5.1.2",
		"cross-env": "^10.1.0",
		"dotenv": "^17.4.2",
		"ethers": "^6.13.1",
		"fs-extra": "^11.2.0",
		"hardhat": "^3.13.0",
		"husky": "^9.1.7",
		"js-sha3": "^0.9.3",
		"mocha": "^11.0.0",
		"prettier": "3.8.0",
		"random-ext": "^2.8.0",
		"rxjs": "^7.8.1",
		"shx": "^0.4.0",
		"sirv-cli": "^3.0.1",
		"solhint": "6.2.3",
		"ts-node": "^10.9.2",
		"tsx": "^4.21.0",
		"typechain": "^8.3.2",
		"typescript": "^5.5.4",
		"typescript-json-serializer": "^6.0.1",
		"winston": "^3.13.1"
	},
	"files": [
		"/contracts"
	],
	"keywords": [
		"defi",
		"ethereum",
		"hardhat",
		"smart-contracts",
		"solidity",
		"typescript"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"preinstall": "node scripts/check-package-manager.js",
		"postinstall": "node scripts/patch-hardhat-verify.js",
		"prepare": "husky",
		"abi:diamond": "node scripts/exportDiamondAbi.mjs",
		"test:diamond-abi": "node --test test/scripts/diamondAbi.test.mjs",
		"clean": "shx rm -rf ./artifacts ./cache ./coverage ./src/types ./coverage.json && npm run typechain",
		"compile": "hardhat compile && node utils/check-contract-sizes.mjs",
		"check:contract-size": "node utils/check-contract-sizes.mjs",
		"check:release": "npm run compile && npm test",
		"coverage": "hardhat test mocha --coverage",
		"lint": "npm run lint:sol && npm run lint:ts",
		"lint:sol": "solhint --config ./.solhint.json --disc --noPoster --quiet \"contracts/**/*.sol\"",
		"lint:ts": "tsc --noEmit --project tsconfig.operations.json",
		"test": "./utils/runTestsInParallel.sh",
		"test:fuzz": "node --import tsx scripts/fuzz.ts",
		"test:fuzz:dashboard": "node --import tsx scripts/fuzz/dashboard.ts",
		"test:fuzz:ci": "cross-env TEST_MODE=fuzz FUZZ_RUN_MODE=bounded hardhat test mocha --bail -- test/sequential/Main.ts",
		"test:cli": "node --test cli/test/*.test.js",
		"test:scripts": "node --import tsx --test scripts/utils/*.test.ts",
		"test:deploy": "hardhat compile && hardhat test mocha --no-compile -- test/parallel/ContractCreationResume.test.ts test/parallel/CopySymbolsPlan.test.ts test/parallel/DeployInfrastructure.test.ts test/parallel/DeploymentRecipeCheckpoint.test.ts test/parallel/DeploymentRecipeComponentExecution.test.ts test/parallel/DeploymentRecipeConfig.test.ts test/parallel/DeploymentRecipeValidation.test.ts test/parallel/DeploymentResumeState.test.ts test/parallel/DeploymentTransactionReconciliation.test.ts test/parallel/DeploymentVerificationBinding.test.ts test/parallel/DeployProtocolConfig.test.ts test/parallel/DeploySystemConfig.test.ts test/parallel/ExecutionGuard.test.ts test/parallel/ExpressProviderDeployment.test.ts test/parallel/MuonDeploymentPermissions.test.ts test/parallel/DeploymentRecordResume.test.ts test/parallel/PartyBDeploymentRecords.test.ts test/parallel/SafeProposal.test.ts test/parallel/VanityRegistry.test.ts test/parallel/VanityPlan.test.ts test/parallel/VanityDeployment.test.ts",
		"check:operations": "npm run lint && npm run test:cli && npm run test:scripts && npm run test:deploy",
		"docs": "node scripts/serve-docs.mjs",
		"docs:dev": "sirv docs --dev --host 127.0.0.1 --port 4173",
		"docs:check": "node docs/check-docs.mjs",
		"abi": "python3 ./utils/make_abi.py",
		"deploy:gasless-layer": "hardhat run scripts/gaslessLayer/deploy.ts",
		"upgrade:gasless-layer:hyperevm": "hardhat run scripts/gaslessLayer/upgrade-gasless-layer.ts --network hyperevm",
		"storage:gasless-layer:snapshot": "hardhat run scripts/gaslessLayer/write-storage-snapshot.ts",
		"typechain": "cross-env TS_NODE_TRANSPILE_ONLY=true hardhat typechain",
		"solhint": "./node_modules/.bin/solhint -f table contracts/**/*.sol",
		"prettier:contracts": "prettier --write \"contracts/**/*.sol\"",
		"prettier:contracts:check": "prettier --check \"contracts/**/*.sol\"",
		"prettier:ts": "prettier --write \"**/*.ts\"",
		"prettier:ts:check": "prettier --check \"**/*.ts\"",
		"cli": "node cli/symmio.js"
	},
	"dependencies": {
		"@clack/prompts": "1.7.0",
		"@safe-global/api-kit": "5.0.2",
		"@safe-global/protocol-kit": "8.0.5",
		"@safe-global/types-kit": "4.0.1",
		"bignumber.js": "^9.3.1",
		"prettier-plugin-solidity": "^2.2.0"
	},
	"overrides": {
		"axios": "1.18.0",
		"mocha": {
			"diff": "8.0.3",
			"serialize-javascript": "7.0.5"
		}
	},
	"bin": "./cli/symmio.js"
}
