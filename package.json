{
  "name": "symmio",
  "description": "Symmio platform contracts",
  "version": "0.8.5",
  "author": {
    "name": "MoonKnight/Naveedinno",
    "url": "https://github.com/SYMM-IO/symmio-core"
  },
  "type": "module",
  "devDependencies": {
    "@ethersproject/abi": "^5.7.0",
    "@ethersproject/abstract-signer": "^5.7.0",
    "@ethersproject/bignumber": "^5.7.0",
    "@ethersproject/bytes": "^5.7.0",
    "@ethersproject/providers": "^5.7.2",
    "@nomicfoundation/hardhat-ethers": "^4.0.3",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "^3.0.2",
    "@nomicfoundation/hardhat-ignition": "^3.0.6",
    "@nomicfoundation/hardhat-ignition-ethers": "^3.0.6",
    "@nomicfoundation/hardhat-keystore": "^3.0.3",
    "@nomicfoundation/hardhat-mocha": "^3.0.8",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.3",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.2",
    "@nomicfoundation/hardhat-typechain": "^3.0.1",
    "@nomicfoundation/hardhat-verify": "^3.0.8",
    "@nomicfoundation/ignition-core": "^3.0.6",
    "@openzeppelin/contracts": "^4.9.6",
    "@openzeppelin/contracts-upgradeable": "^4.9.6",
    "@trivago/prettier-plugin-sort-imports": "^6.0.0",
    "@types/fs-extra": "^11.0.4",
    "@types/mocha": "^10.0.7",
    "@types/node": "^20.14.12",
    "bignumber.js": "^9.1.2",
    "builder-pattern": "^2.2.0",
    "chai": "^5.1.2",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.1",
    "fs-extra": "^11.2.0",
    "hardhat": "3.1.0",
    "js-sha3": "^0.9.3",
    "mocha": "^11.7.5",
    "random-ext": "^2.8.0",
    "rxjs": "^7.8.1",
    "shx": "^0.3.4",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.5.4",
    "typescript-json-serializer": "^6.0.1",
    "winston": "^3.13.1"
  },
  "files": [
    "/contracts"
  ],
  "keywords": [
    "defi",
    "ethereum",
    "hardhat",
    "smart-contracts",
    "solidity",
    "typescript"
  ],
  "packageManager": "yarn@1.22.22",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "shx rm -rf ./artifacts ./cache ./coverage ./src/types ./coverage.json && yarn typechain",
    "compile": "cross-env TS_NODE_TRANSPILE_ONLY=true hardhat compile",
    "coverage": "hardhat test --coverage",
    "coverage:uncheck-muon": "./utils/runCoverage.sh",
    "lint": "yarn lint:sol && yarn lint:ts",
    "lint:sol": "solhint --config ./.solhint.json --solcoverjs ./.solcover.js --max-warnings 0 \"contracts/**/*.sol\"",
    "test": "hardhat test",
    "typechain": "cross-env TS_NODE_TRANSPILE_ONLY=true hardhat typechain",
    "test:uncheck-muon": "./utils/runTests.sh",
    "solhint": "./node_modules/.bin/solhint -f table contracts/**/*.sol"
  },
  "dependencies": {
    "prettier-plugin-solidity": "^2.2.0"
  }
}
