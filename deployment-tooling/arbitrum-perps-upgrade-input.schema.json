{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://operations.symm.io/schemas/arbitrum-perps-upgrade-input-v1.json",
	"title": "SYMMIO Arbitrum Perps upgrade input",
	"type": "object",
	"additionalProperties": false,
	"required": ["apiVersion", "kind", "name", "network", "source", "governance", "contracts", "instantLayer", "gaslessLayer", "execution"],
	"properties": {
		"$schema": { "type": "string" },
		"apiVersion": { "const": "operations.symm.io/arbitrum-perps-upgrade-input-v1" },
		"kind": { "const": "ArbitrumPerpsUpgrade" },
		"name": { "type": "string", "minLength": 1 },
		"network": {
			"type": "object",
			"additionalProperties": false,
			"required": ["name", "chainId", "mode"],
			"properties": { "name": { "const": "arbitrum" }, "chainId": { "const": 42161 }, "mode": { "const": "live" } }
		},
		"source": {
			"type": "object",
			"additionalProperties": false,
			"required": ["commit", "recipe"],
			"properties": {
				"commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
				"recipe": {
					"type": "object",
					"additionalProperties": false,
					"required": ["path", "digest"],
					"properties": { "path": { "type": "string", "minLength": 1 }, "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
				}
			}
		},
		"governance": { "$ref": "#/$defs/governance" },
		"contracts": { "$ref": "#/$defs/contracts" },
		"instantLayer": { "$ref": "#/$defs/instantLayer" },
		"gaslessLayer": { "$ref": "#/$defs/gaslessLayer" },
		"execution": {
			"type": "object",
			"additionalProperties": false,
			"required": ["verify", "confirmations", "txTimeoutSeconds", "slowNoticeSeconds", "requireForkRehearsal"],
			"properties": {
				"verify": { "const": true },
				"confirmations": { "type": "integer", "minimum": 1 },
				"txTimeoutSeconds": { "type": "integer", "minimum": 30 },
				"slowNoticeSeconds": { "type": "integer", "minimum": 5 },
				"requireForkRehearsal": { "const": true }
			}
		}
	},
	"$defs": {
		"address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
		"uintString": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
		"governance": {
			"type": "object",
			"additionalProperties": false,
			"required": ["safe", "previousAdmin"],
			"properties": {
				"safe": { "const": "0x89bE952790657297ac03f1954b22B668d819D3d9" },
				"previousAdmin": { "const": "0x77A955776Ee1dd3E9C800c3214ed489441d74b94" }
			}
		},
		"contracts": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"core",
				"collateral",
				"accountLayer",
				"currentInstantLayer",
				"expressProvider",
				"signatureVerifier",
				"symbolManager",
				"feesManager",
				"create2Factory",
				"currentGaslessLayer",
				"liquidatorProxy"
			],
			"properties": {
				"core": { "const": "0x573310dB6d160B26026B8706EBe9831c7dEF1D09" },
				"collateral": { "const": "0xaf88d065e77c8cC2239327C5EDb3A432268e5831" },
				"accountLayer": { "const": "0x5733107211B2801Acd39933a54d482FE303c4907" },
				"currentInstantLayer": { "const": "0xDBc6DAe3De0b10a10b6c4d1b33D4C79567E07F6d" },
				"expressProvider": { "const": "0x573310D7b04fF21BB8628C69eE103dDF4922294A" },
				"signatureVerifier": { "const": "0xe8D2220Fd6D56C3f2fBDB3c7FF14FEAFA7573695" },
				"symbolManager": { "const": "0x902a529f5f1E9BCEBe7BC6e785A70aC2Db07Ad2c" },
				"feesManager": { "const": "0xc9B7E07E2Fce4FbFbf59D7d06b41Dc5e2Bd495e1" },
				"create2Factory": { "const": "0x99B425BC19F99a1B922664c0E4fa8A0870CE9975" },
				"currentGaslessLayer": { "const": "0x1c863aF5affc105EE42B8CAbA617E033A8F3Be22" },
				"liquidatorProxy": { "const": "0xC180F4C7c6c7C6a2247073Ca7bEaEBeb00D1D23F" }
			}
		},
		"operation": {
			"type": "object",
			"additionalProperties": false,
			"required": ["insertionPoints", "sourceIndices", "sourceOffsets"],
			"properties": {
				"insertionPoints": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
				"sourceIndices": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
				"sourceOffsets": { "type": "array", "items": { "type": "integer", "minimum": 0 } }
			}
		},
		"instantLayer": {
			"type": "object",
			"additionalProperties": false,
			"required": ["mode", "admin", "templates"],
			"properties": {
				"mode": { "const": "deploy" },
				"admin": { "const": "0x89bE952790657297ac03f1954b22B668d819D3d9" },
				"templates": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["name", "operations"],
						"properties": {
							"name": { "type": "string", "minLength": 1 },
							"instantOpenMode": { "type": "boolean" },
							"operations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/operation" } }
						}
					}
				}
			}
		},
		"gaslessLayer": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"mode",
				"admin",
				"treasury",
				"depositFee",
				"minimumDeposit",
				"defaultSelectorFee",
				"dailyFreeOpsLimit",
				"revertWhenFreeQuotaExhausted",
				"dailySponsoredNativeLimit",
				"revertWhenNativeSponsorLimitExhausted",
				"maxNativeGasTopUpAmount",
				"nativeGasTopUpFeeBps",
				"relayers",
				"selectorFees"
			],
			"properties": {
				"mode": { "const": "deploy" },
				"admin": { "const": "0x89bE952790657297ac03f1954b22B668d819D3d9" },
				"treasury": { "$ref": "#/$defs/address" },
				"depositFee": { "$ref": "#/$defs/uintString" },
				"minimumDeposit": { "$ref": "#/$defs/uintString" },
				"defaultSelectorFee": { "$ref": "#/$defs/uintString" },
				"dailyFreeOpsLimit": { "$ref": "#/$defs/uintString" },
				"revertWhenFreeQuotaExhausted": { "type": "boolean" },
				"dailySponsoredNativeLimit": { "$ref": "#/$defs/uintString" },
				"revertWhenNativeSponsorLimitExhausted": { "type": "boolean" },
				"maxNativeGasTopUpAmount": { "$ref": "#/$defs/uintString" },
				"nativeGasTopUpFeeBps": { "type": "integer", "minimum": 0, "maximum": 10000 },
				"relayers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/address" } },
				"selectorFees": {
					"type": "array",
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["selector", "configured", "amount"],
						"properties": {
							"selector": { "type": "string", "pattern": "^0x[0-9a-fA-F]{8}$" },
							"configured": { "type": "boolean" },
							"amount": { "$ref": "#/$defs/uintString" }
						}
					}
				}
			}
		}
	}
}
