{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Core upgrade input (v1 and categorized v2)",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"$schema": {
			"type": "string"
		},
		"apiVersion": {
			"enum": ["operations.symm.io/core-upgrade-input-v1", "operations.symm.io/core-upgrade-input-v2"]
		},
		"kind": {
			"const": "CoreUpgradeInput"
		},
		"name": {
			"type": "string",
			"pattern": "^[a-z][a-z0-9-]*$"
		},
		"network": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"name": {
					"type": "string",
					"minLength": 1
				},
				"chainId": {
					"type": "integer",
					"minimum": 1
				},
				"fork": {
					"type": "string",
					"minLength": 1
				}
			},
			"required": ["name", "chainId", "fork"]
		},
		"release": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"ref": {
					"type": "string",
					"minLength": 1
				},
				"baselineRef": {
					"type": "string",
					"minLength": 1
				}
			},
			"required": ["ref", "baselineRef"]
		},
		"credentials": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"deployer": {
					"type": "string",
					"pattern": "^hardhat-keystore://[A-Za-z_][A-Za-z0-9_]*$"
				},
				"rpc": {
					"type": "string",
					"pattern": "^hardhat-keystore://[A-Za-z_][A-Za-z0-9_]*$"
				},
				"explorer": {
					"type": "string",
					"pattern": "^hardhat-keystore://[A-Za-z_][A-Za-z0-9_]*$"
				}
			},
			"required": ["deployer", "rpc", "explorer"]
		},
		"execution": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"confirmations": {
					"type": "integer",
					"minimum": 1
				},
				"txTimeoutSeconds": {
					"type": "integer",
					"minimum": 1
				},
				"slowNoticeSeconds": {
					"type": "integer",
					"minimum": 1
				},
				"verify": {
					"const": true
				},
				"logLevel": {
					"enum": ["quiet", "normal", "verbose"]
				}
			},
			"required": ["confirmations", "txTimeoutSeconds", "slowNoticeSeconds", "verify", "logLevel"]
		},
		"governance": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"kind": {
					"enum": ["safe", "eoa"]
				},
				"owner": {
					"type": "string",
					"pattern": "^0x[0-9a-fA-F]{40}$"
				},
				"signerMode": {
					"enum": ["safe-file", "ledger", "hardhat-keystore"]
				},
				"signerKey": {
					"type": "string",
					"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
				},
				"ledgerDerivation": {
					"enum": ["ledger-live", "legacy"]
				},
				"accountLayerOwner": {
					"type": "string",
					"pattern": "^0x[0-9a-fA-F]{40}$"
				}
			},
			"required": ["kind", "owner", "signerMode", "accountLayerOwner"]
		},
		"target": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"core": {
					"type": "string",
					"pattern": "^0x[0-9a-fA-F]{40}$"
				},
				"collateral": {
					"type": "string",
					"pattern": "^0x[0-9a-fA-F]{40}$"
				},
				"accountLayer": {
					"type": "string",
					"pattern": "^0x[0-9a-fA-F]{40}$"
				},
				"instantLayer": {
					"type": "string",
					"pattern": "^0x[0-9a-fA-F]{40}$"
				},
				"signatureVerifier": {
					"type": "string",
					"pattern": "^0x[0-9a-fA-F]{40}$"
				},
				"symbolManager": {
					"type": "string",
					"pattern": "^0x[0-9a-fA-F]{40}$"
				},
				"gaslessLayer": {
					"type": "string",
					"pattern": "^0x[0-9a-fA-F]{40}$"
				},
				"liquidator": {
					"type": "string",
					"pattern": "^0x[0-9a-fA-F]{40}$"
				},
				"gaslessReceiver": {
					"type": "string",
					"pattern": "^0x[0-9a-fA-F]{40}$"
				},
				"partyB": {
					"type": "string",
					"pattern": "^0x[0-9a-fA-F]{40}$"
				},
				"multicall": {
					"type": "string",
					"pattern": "^0x[0-9a-fA-F]{40}$"
				}
			},
			"required": [
				"core",
				"collateral",
				"accountLayer",
				"instantLayer",
				"signatureVerifier",
				"symbolManager",
				"gaslessLayer",
				"liquidator",
				"gaslessReceiver",
				"partyB",
				"multicall"
			]
		},
		"muon": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"requiredFunctions": {
					"type": "array",
					"minItems": 1,
					"uniqueItems": true,
					"items": {
						"type": "string"
					}
				},
				"additionalVerifierRoles": {
					"type": "array",
					"uniqueItems": true,
					"items": {
						"type": "string",
						"pattern": "^0x[0-9a-fA-F]{64}$"
					}
				},
				"maxRoleMembers": {
					"type": "integer",
					"minimum": 1
				},
				"maxSigners": {
					"type": "integer",
					"minimum": 1
				}
			}
		},
		"limits": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"maxQuotes": {
					"type": "integer",
					"minimum": 1
				},
				"maxSymbols": {
					"type": "integer",
					"minimum": 1
				}
			},
			"required": ["maxQuotes", "maxSymbols"]
		},
		"storage": {
			"type": "object"
		},
		"repairAggregateFunding": {
			"const": true
		},
		"allowedRemovedSelectors": {
			"$ref": "#/definitions/allowedRemovals"
		},
		"roleGrants": {
			"oneOf": [{ "$ref": "#/definitions/flatRoleGrants" }, { "$ref": "#/definitions/categorizedRoleGrants" }]
		},
		"inventory": {
			"type": "object",
			"additionalProperties": {
				"oneOf": [
					{
						"type": "object",
						"additionalProperties": false,
						"properties": {
							"kind": {
								"enum": ["contract", "account"]
							},
							"address": {
								"type": "string",
								"pattern": "^0x[0-9a-fA-F]{40}$"
							}
						},
						"required": ["kind", "address"]
					},
					{
						"type": "object",
						"additionalProperties": false,
						"properties": {
							"kind": {
								"const": "subgraph"
							},
							"url": {
								"type": "string",
								"pattern": "^https://[^\\s]+$"
							}
						},
						"required": ["kind", "url"]
					}
				]
			}
		},
		"funding": {
			"$ref": "#/definitions/fundingPolicies"
		},
		"selectors": {
			"$ref": "#/definitions/selectorPolicies"
		}
	},
	"required": [
		"apiVersion",
		"kind",
		"name",
		"network",
		"release",
		"credentials",
		"execution",
		"governance",
		"target",
		"limits",
		"storage",
		"roleGrants"
	],
	"definitions": {
		"flatRoleGrants": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"holder": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
					"role": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*_ROLE$" }
				},
				"required": ["holder", "role"]
			}
		},
		"categorizedRoleGrants": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"core": {
					"type": "array",
					"items": {
						"type": "object",
						"additionalProperties": false,
						"properties": {
							"holder": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
							"holderRef": { "enum": ["target.symbolManager", "governance.owner"] },
							"role": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*_ROLE$" }
						},
						"required": ["role"],
						"oneOf": [
							{ "properties": { "holder": {} }, "required": ["holder"] },
							{ "properties": { "holderRef": {} }, "required": ["holderRef"] }
						]
					}
				}
			},
			"required": ["core"]
		},
		"symbolAdjustment": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"legacyAdjustmentWords": {
					"const": 15
				},
				"upgradedAdjustmentWords": {
					"const": 17
				},
				"requireEmptyAdjustments": {
					"const": true
				}
			},
			"required": ["legacyAdjustmentWords", "upgradedAdjustmentWords", "requireEmptyAdjustments"]
		},
		"allowedRemovals": {
			"type": "array",
			"items": {
				"type": "string",
				"pattern": "^0x[0-9a-f]{8}$"
			},
			"uniqueItems": true
		},
		"categorizedStorage": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"symbolAdjustment": {
					"$ref": "#/definitions/symbolAdjustment"
				}
			},
			"required": ["symbolAdjustment"]
		},
		"fundingPolicies": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"aggregate": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"repair": {
							"const": true
						}
					},
					"required": ["repair"]
				}
			},
			"required": ["aggregate"]
		},
		"selectorPolicies": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"core": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"allowedRemovals": {
							"$ref": "#/definitions/allowedRemovals"
						}
					},
					"required": ["allowedRemovals"]
				}
			},
			"required": ["core"]
		}
	},
	"if": {
		"properties": {
			"apiVersion": {
				"const": "operations.symm.io/core-upgrade-input-v1"
			}
		}
	},
	"then": {
		"properties": {
			"roleGrants": { "$ref": "#/definitions/flatRoleGrants" },
			"storage": {
				"$ref": "#/definitions/symbolAdjustment"
			},
			"funding": false,
			"selectors": false,
			"repairAggregateFunding": {
				"const": true
			},
			"allowedRemovedSelectors": {
				"$ref": "#/definitions/allowedRemovals"
			}
		},
		"required": ["repairAggregateFunding", "allowedRemovedSelectors"]
	},
	"else": {
		"properties": {
			"storage": {
				"$ref": "#/definitions/categorizedStorage"
			},
			"repairAggregateFunding": false,
			"allowedRemovedSelectors": false,
			"funding": {
				"$ref": "#/definitions/fundingPolicies"
			},
			"selectors": {
				"$ref": "#/definitions/selectorPolicies"
			}
		},
		"required": ["funding", "selectors"]
	}
}
