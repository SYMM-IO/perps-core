{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		"types": ["node"]
	},
	"include": ["hardhat.config.ts", "tasks/**/*.ts", "scripts/**/*.ts"],
	"exclude": [
		// These are test-model harnesses covered by the Hardhat test suites. Including them
		// pulls the entire legacy test type graph into the deployment/tooling gate.
		"scripts/fuzz.ts",
		"scripts/fuzz/**",
		"scripts/Initialize.ts"
	]
}
