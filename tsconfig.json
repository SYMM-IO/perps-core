{
  "compilerOptions": {
    "target": "es2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noErrorTruncation": true,
    "types": [
      "node",
      "mocha",
      "chai"
    ],
    "typeRoots": [
      "./types",
      "./node_modules/@types"
    ]
  },
  "include": [
    "hardhat.config.ts",
    "scripts/**/*.ts",
    "tasks/**/*.ts",
    "test/**/*.ts",
    "utils/**/*.ts",
    "src/**/*.ts",
    "types/**/*.d.ts"
  ]
}
